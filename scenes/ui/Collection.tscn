[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/Collection.gd" id="1"]

[node name="Collection" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="BG" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.1, 0.12, 0.18, 1)

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 40.0
offset_top = 16.0
offset_right = -40.0
offset_bottom = -16.0
theme_override_constants/separation = 6

[node name="Title" type="Label" parent="VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 26
text = "COLLECTION & TEAM"
horizontal_alignment = 1

[node name="TeamLabel" type="Label" parent="VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "Team: "

[node name="MonsterList" type="ItemList" parent="VBox"]
custom_minimum_size = Vector2(0, 150)
layout_mode = 2
size_flags_vertical = 3

[node name="InfoLabel" type="Label" parent="VBox"]
custom_minimum_size = Vector2(0, 70)
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "Select a monster"

[node name="Buttons" type="HBoxContainer" parent="VBox"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 8

[node name="AddTeam" type="Button" parent="VBox/Buttons"]
custom_minimum_size = Vector2(120, 44)
layout_mode = 2
text = "Add Team"

[node name="RemoveTeam" type="Button" parent="VBox/Buttons"]
custom_minimum_size = Vector2(100, 44)
layout_mode = 2
text = "Remove"

[node name="MoveUp" type="Button" parent="VBox/Buttons"]
custom_minimum_size = Vector2(90, 44)
layout_mode = 2
text = "Slot ↑"

[node name="MoveDown" type="Button" parent="VBox/Buttons"]
custom_minimum_size = Vector2(90, 44)
layout_mode = 2
text = "Slot ↓"

[node name="FeedBtn" type="Button" parent="VBox/Buttons"]
custom_minimum_size = Vector2(90, 44)
layout_mode = 2
text = "Feed"

[node name="InvLabel" type="Label" parent="VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "Inventory: "

[node name="HatchLabel" type="Label" parent="VBox"]
layout_mode = 2
text = "Hatch: "

[node name="HatchBar" type="ProgressBar" parent="VBox"]
custom_minimum_size = Vector2(0, 22)
layout_mode = 2
max_value = 100.0
show_percentage = true

[node name="HatchButtons" type="HBoxContainer" parent="VBox"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 10

[node name="StartHatch" type="Button" parent="VBox/HatchButtons"]
custom_minimum_size = Vector2(150, 44)
layout_mode = 2
text = "Start Hatch"

[node name="FinishHatch" type="Button" parent="VBox/HatchButtons"]
custom_minimum_size = Vector2(130, 44)
layout_mode = 2
text = "Finish Hatch"

[node name="SpeedHatch" type="Button" parent="VBox/HatchButtons"]
custom_minimum_size = Vector2(120, 44)
layout_mode = 2
text = "Speed Up"

[node name="BackBtn" type="Button" parent="VBox"]
custom_minimum_size = Vector2(160, 48)
layout_mode = 2
size_flags_horizontal = 4
text = "Back"

[connection signal="pressed" from="VBox/Buttons/AddTeam" to="." method="_on_add_to_team"]
[connection signal="pressed" from="VBox/Buttons/RemoveTeam" to="." method="_on_remove_from_team"]
[connection signal="pressed" from="VBox/Buttons/MoveUp" to="." method="_on_move_up"]
[connection signal="pressed" from="VBox/Buttons/MoveDown" to="." method="_on_move_down"]
[connection signal="pressed" from="VBox/Buttons/FeedBtn" to="." method="_on_feed"]
[connection signal="pressed" from="VBox/HatchButtons/StartHatch" to="." method="_on_start_hatch"]
[connection signal="pressed" from="VBox/HatchButtons/FinishHatch" to="." method="_on_finish_hatch"]
[connection signal="pressed" from="VBox/HatchButtons/SpeedHatch" to="." method="_on_speed_hatch"]
[connection signal="pressed" from="VBox/BackBtn" to="." method="_on_back"]

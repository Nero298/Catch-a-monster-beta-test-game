[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/Shop.gd" id="1"]

[node name="Shop" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="BG" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.12, 0.14, 0.2, 1)

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -280.0
offset_top = -300.0
offset_right = 280.0
offset_bottom = 300.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "SHOP"
horizontal_alignment = 1

[node name="GoldLabel" type="Label" parent="VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "Gold: 0"
horizontal_alignment = 1

[node name="BallsTitle" type="Label" parent="VBox"]
layout_mode = 2
text = "— Balls —"
horizontal_alignment = 1

[node name="Balls" type="HBoxContainer" parent="VBox"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 10

[node name="BasicBtn" type="Button" parent="VBox/Balls"]
custom_minimum_size = Vector2(160, 50)
layout_mode = 2
text = "Basic"

[node name="GreatBtn" type="Button" parent="VBox/Balls"]
custom_minimum_size = Vector2(160, 50)
layout_mode = 2
text = "Great"

[node name="UltraBtn" type="Button" parent="VBox/Balls"]
custom_minimum_size = Vector2(160, 50)
layout_mode = 2
text = "Ultra"

[node name="UpgradeTitle" type="Label" parent="VBox"]
layout_mode = 2
text = "— Upgrade Balls (Gold) —"
horizontal_alignment = 1

[node name="Upgrades" type="HBoxContainer" parent="VBox"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 10

[node name="UpBasic" type="Button" parent="VBox/Upgrades"]
custom_minimum_size = Vector2(160, 45)
layout_mode = 2
text = "Up Basic"

[node name="UpGreat" type="Button" parent="VBox/Upgrades"]
custom_minimum_size = Vector2(160, 45)
layout_mode = 2
text = "Up Great"

[node name="UpUltra" type="Button" parent="VBox/Upgrades"]
custom_minimum_size = Vector2(160, 45)
layout_mode = 2
text = "Up Ultra"

[node name="ItemsTitle" type="Label" parent="VBox"]
layout_mode = 2
text = "— Food & Stones —"
horizontal_alignment = 1

[node name="Items" type="GridContainer" parent="VBox"]
layout_mode = 2
columns = 3
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8

[node name="MeatBtn" type="Button" parent="VBox/Items"]
custom_minimum_size = Vector2(160, 48)
layout_mode = 2
text = "Meat 40G"

[node name="PremiumBtn" type="Button" parent="VBox/Items"]
custom_minimum_size = Vector2(160, 48)
layout_mode = 2
text = "Premium 120G"

[node name="FireBtn" type="Button" parent="VBox/Items"]
custom_minimum_size = Vector2(160, 48)
layout_mode = 2
text = "Fire Stone 200G"

[node name="WaterBtn" type="Button" parent="VBox/Items"]
custom_minimum_size = Vector2(160, 48)
layout_mode = 2
text = "Water Stone 200G"

[node name="LeafBtn" type="Button" parent="VBox/Items"]
custom_minimum_size = Vector2(160, 48)
layout_mode = 2
text = "Leaf Stone 200G"

[node name="StatusLabel" type="Label" parent="VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = ""
horizontal_alignment = 1

[node name="BackBtn" type="Button" parent="VBox"]
custom_minimum_size = Vector2(200, 55)
layout_mode = 2
size_flags_horizontal = 4
text = "Back"

[connection signal="pressed" from="VBox/Balls/BasicBtn" to="." method="_on_buy_basic"]
[connection signal="pressed" from="VBox/Balls/GreatBtn" to="." method="_on_buy_great"]
[connection signal="pressed" from="VBox/Balls/UltraBtn" to="." method="_on_buy_ultra"]
[connection signal="pressed" from="VBox/Upgrades/UpBasic" to="." method="_on_upgrade_basic"]
[connection signal="pressed" from="VBox/Upgrades/UpGreat" to="." method="_on_upgrade_great"]
[connection signal="pressed" from="VBox/Upgrades/UpUltra" to="." method="_on_upgrade_ultra"]
[connection signal="pressed" from="VBox/Items/MeatBtn" to="." method="_on_buy_meat"]
[connection signal="pressed" from="VBox/Items/PremiumBtn" to="." method="_on_buy_premium"]
[connection signal="pressed" from="VBox/Items/FireBtn" to="." method="_on_buy_fire_stone"]
[connection signal="pressed" from="VBox/Items/WaterBtn" to="." method="_on_buy_water_stone"]
[connection signal="pressed" from="VBox/Items/LeafBtn" to="." method="_on_buy_leaf_stone"]
[connection signal="pressed" from="VBox/BackBtn" to="." method="_on_back"]
